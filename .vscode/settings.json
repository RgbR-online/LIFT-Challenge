{
  "version": "0.2.0",
  "configurations": [
      {
          "name": "Run Makefile",
          "type": "cppdbg",
          "request": "launch",
          "preLaunchTask": "Build (Makefile)", 
          "program": "${workspaceFolder}/mon_programme",  
          "args": [],
          "cwd": "${workspaceFolder}",
          "stopAtEntry": false,
          "environment": [],
          "externalConsole": true,
          "MIMode": "gdb",
          "setupCommands": [
              {
                  "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": true
              }
          ],
          "miDebuggerPath": "/usr/bin/gdb"
      }
  ]
}